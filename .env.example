# ElevenLabs Conversational AI (public agent, auth disabled)
NEXT_PUBLIC_ELEVENLABS_AGENT_ID=

# Optional contact fallbacks shown in the agent drawer
NEXT_PUBLIC_AGENT_PHONE=
NEXT_PUBLIC_AGENT_WHATSAPP=

# Contact form (Resend). Without RESEND_API_KEY the form shows an email fallback.
RESEND_API_KEY=
# Where inquiries land, and the sender (graynest.co is verified in Resend)
CONTACT_TO=hello@graynest.co
CONTACT_FROM="GrayNest Website <hello@graynest.co>"
